# ==============================================================================
# Wearable Health IoT Platform - Environment Configuration Example
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: copy .env.example .env
# 2. Update with your Microsoft Fabric Eventstream custom endpoint when configured.
# ==============================================================================

# Microsoft Fabric Eventstream Custom App Ingestion Endpoint (HTTP)
# (Leave empty during local simulation testing)
FABRIC_EVENTSTREAM_ENDPOINT=https://<your-fabric-eventstream-endpoint>

# Microsoft Fabric Eventstream (Event Hubs Protocol)
FABRIC_EVENTHUB_CONNECTION_STRING=
FABRIC_EVENTHUB_NAME=

# Simulator Settings
SIMULATOR_DEVICE_COUNT=5
SIMULATOR_INTERVAL_SECONDS=2
SIMULATOR_ANOMALY_RATE=0.05
